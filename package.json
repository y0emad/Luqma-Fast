{
  "name": "luqma-fast",
  "version": "1.0.0",
  "description": "Luqma Fast: food delivery REST API (Express 5, TypeScript, MongoDB, Redis, Paymob)",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/seed.ts",
    "lock:linux": "docker run --rm -v \"$PWD:/app\" -w /app node:24-slim npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.1.6",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.9",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.11",
    "redis-commander": "^0.9.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
