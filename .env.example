# Copy this file to .env and fill in the values:  cp .env.example .env

# ---- Server ----
PORT=3000
NODE_ENV=development
# Frontend origins allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:5173
# Set to true when the app runs behind a reverse proxy (e.g. Caddy), so rate limits see the real visitor IP
TRUST_PROXY=false

# ---- Databases ----
# Your local MongoDB, or the one from docker-compose.yml (published on 27018)
MONGO_URI=mongodb://127.0.0.1:27017/LuqmaFast
# docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# Two different secrets, at least 32 characters each: the server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Email (verification and reset codes, order confirmations) ----
# smtp  = nodemailer with EMAIL_HOST/PORT/USER/PASS (Gmail app password or https://ethereal.email)
# brevo = Brevo HTTP API with BREVO_API_KEY (use this in production: cloud hosts often block SMTP)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# The sender. With Brevo it must be a sender you verified in Brevo.
EMAIL_FROM=
EMAIL_FROM_NAME=Luqma Fast
BREVO_API_KEY=

# ---- Admin account (created by: npm run db:seed) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASS=

# ---- Timezone for opening hours and daily stats ----
APP_TZ=Africa/Cairo

# ---- Online payment: Paymob (Egypt) ----
# Leave empty to run cash-only. Get the test values from the Paymob dashboard (test mode):
#   Settings → Account Info: secret key, public key, HMAC secret
#   Developers → Payment Integrations: the integration id(s), comma-separated (card, wallet…)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_CURRENCY=EGP
# The public address of this API: Paymob sends the webhook and the customer back here.
# Locally, use a tunnel (e.g. `cloudflared tunnel --url http://localhost:3000`) and paste its https URL.
PUBLIC_URL=http://localhost:3000
